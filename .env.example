POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gymvault
POSTGRES_PORT=5432

# Used by the app and the migration runner to connect.
DATABASE_URL=postgres://gymvault:gymvault@localhost:5432/gymvault?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PORT=6379

# Rate limits (requests per minute, per client IP). Auth = login/register only.
RATE_LIMIT_AUTH=5
RATE_LIMIT_DEFAULT=100
