POSTGRES_USER=opengymvault
POSTGRES_PASSWORD=opengymvault
POSTGRES_DB=opengymvault
POSTGRES_PORT=5432

DATABASE_URL=postgres://opengymvault:opengymvault@localhost:5432/opengymvault?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PORT=6379

HTTP_ADDR=:8080

RATE_LIMIT_AUTH=5
RATE_LIMIT_DEFAULT=100

# Example: TRUSTED_PROXIES=172.18.0.0/16,10.0.0.5
TRUSTED_PROXIES=

# Postgres connection pool tuning.
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=1
DB_POOL_CONN_MAX_LIFETIME=1h
DB_POOL_CONN_IDLE_TIME=30m
DB_POOL_HEALTH_CHECK_PERIOD=1m

SHUTDOWN_TIMEOUT=10s
